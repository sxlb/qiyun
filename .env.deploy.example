# ===== 无需手动修改（脚本自动生成） =====

# NextAuth 密钥：用于签名 JWT，deploy.sh 会自动生成随机值填入
# 此处的 __GENERATE_RANDOM_KEY__ 哨兵占位值会被部署脚本自动替换为随机密钥，无需手动操作
NEXTAUTH_SECRET=__GENERATE_RANDOM_KEY__

# ===== 可选 =====

# 备份文件 HMAC 签名密钥（用于校验备份恢复完整性，防止篡改）
# 【生产环境必填】未配置时导出/恢复备份会直接失败，以防有人用可预测的默认密钥伪造备份覆盖数据库
# deploy.sh 会在首次部署时自动生成并填入；手动部署请自行执行 openssl rand -hex 32
# BACKUP_HMAC_KEY=

# 站点完整访问地址（反向代理或自定义域名时必须设置）
# 本地部署：http://localhost:3000
# 域名部署：https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# （可选，但强烈建议设置）默认管理员密码：需 ≥ 8 位
# 仅在「首次创建数据库」时生效（用户表为空时才会创建 admin）
# 留空或不足 8 位时，默认账号密码固定为 123456
# 注意：数据库一旦创建，之后修改本项不再生效（seed 会跳过已存在的用户）
SEED_ADMIN_PASSWORD=

# （可选）访问明细保留天数：超过该天数的 VisitRecord 会在每日首次访问上报时被清理
# 留空按默认 180 天处理；填 0 表示永久保留（数据库会持续增长）
# VISIT_RECORD_RETENTION_DAYS=180

# 默认账号说明：
# 首次启动会自动创建默认账号 admin，密码为上方 SEED_ADMIN_PASSWORD（未设置则为 123456），
# 首次登录会强制要求改密，请登录后台后在「账号设置」中修改
