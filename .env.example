# SQLite 数据库路径（本地开发用，Docker 部署时由 docker-compose 覆盖）
# 注意：相对路径以 prisma/schema.prisma 所在目录为基准，故用 ./dev.db 即落在 prisma/dev.db
DATABASE_URL="file:./dev.db"

# NextAuth 密钥（本地开发可用任意 32 字符以上字符串，生产环境必须用 `openssl rand -base64 32` 生成）
# 注意：请勿直接使用本占位值，复制后请改为随机字符串
NEXTAUTH_SECRET="<请使用 openssl rand -base64 32 生成后的随机密钥替换此处>"

# 站点地址（本地开发可省略）
NEXTAUTH_URL="http://localhost:3000"

# （可选）默认管理员密码：首次 seed 时使用，需 ≥ 8 位；留空则自动生成随机密码并打印到日志
# 生产环境建议设置，例如：SEED_ADMIN_PASSWORD="$(openssl rand -base64 12)"
SEED_ADMIN_PASSWORD=""

# 默认账号说明：
# 首次运行 seed 会自动创建默认账号 admin（密码见上方 SEED_ADMIN_PASSWORD 或启动日志）
# 请登录后台后立即在「账号设置」中修改

# 备份文件 HMAC 签名密钥（用于校验备份恢复完整性，防止篡改）
# 建议用 `openssl rand -hex 32` 生成随机值，留空则使用默认弱值（仅开发环境推荐）
BACKUP_HMAC_KEY="<请使用 openssl rand -hex 32 生成"
