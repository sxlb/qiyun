# SQLite 数据库路径（本地开发用，Docker 部署时由 docker-compose 覆盖）
# 注意：相对路径以 prisma/schema.prisma 所在目录为基准，故用 ./dev.db 即落在 prisma/dev.db
DATABASE_URL="file:./dev.db"

# NextAuth 密钥（本地开发可用任意 32 字符以上字符串，生产环境必须用 `openssl rand -base64 32` 生成）
# 注意：请勿直接使用本占位值，复制后请改为随机字符串
NEXTAUTH_SECRET="<请使用 openssl rand -base64 32 生成后的随机密钥替换此处>"

# 站点地址（本地开发可省略）
NEXTAUTH_URL="http://localhost:3000"

# （可选）默认管理员密码：首次 seed 时使用，需 ≥ 8 位；留空或不足 8 位时固定为 123456
# 生产环境建议设置，例如：SEED_ADMIN_PASSWORD="$(openssl rand -base64 12)"
SEED_ADMIN_PASSWORD=""

# 默认账号说明：
# 首次运行 seed 会自动创建默认账号 admin（密码取上方 SEED_ADMIN_PASSWORD，未设置则为 123456）
# 登录后台后会提示强制改密，请在「账号设置」中修改

# 备份文件 HMAC 签名密钥（用于校验备份恢复完整性，防止篡改）
# 【生产环境必填】未配置时导出/恢复备份会直接失败，以防有人用可预测的默认密钥伪造备份覆盖数据库
# 生成方式：openssl rand -hex 32
BACKUP_HMAC_KEY="<请使用 openssl rand -hex 32 生成后的随机密钥替换此处>"

# （可选）访问明细保留天数：超过该天数的 VisitRecord 会在每日首次访问上报时被清理
# 留空按默认 180 天处理；填 0 表示永久保留（数据库会持续增长）
# VISIT_RECORD_RETENTION_DAYS=180
