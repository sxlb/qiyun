# 包下载源：默认走 npmjs 官方源。历史上本机曾用 npmmirror 进行"国内加速"，
# 但实测这台部署机(103.153.100.128)直连 registry.npmjs.org 仅 ~0.04s，
# 而 npmmirror 易重定向且更慢，反而导致 `npm ci` 长时间卡死在网络等待。
# 故统一回退到官方源；若部署到其他直连 npmjs 较慢的机器，可在 Docker 构建时
# 通过 --build-arg NPM_REGISTRY=... 覆盖（Dockerfile 中 npm_config_registry 环境变量
# 优先级高于本文件，覆盖即生效）。
registry=https://registry.npmjs.org

# 网络韧性：镜像波动时快速失败并重试，而不是挂死数十分钟（2GB 小机 Docker 构建）
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=240000